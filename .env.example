# Copy to .env and fill in what you have. Everything is optional.

# Amazon Selling Partner API — FREE with a Professional seller account.
# Gives: real gated/ungated check for YOUR account + Amazon's real fees.
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_SELLER_ID=

# Keepa — PAID. Gives: price/rank history, monthly sold, seller storefront tracking.
KEEPA_API_KEY=

# Claude — pay as you go. Gives: AI risk flags (hazmat, IP complaints, likely stores).
ANTHROPIC_API_KEY=

# Discord — FREE. Gives: buy alerts on your phone.
DISCORD_WEBHOOK_URL=
